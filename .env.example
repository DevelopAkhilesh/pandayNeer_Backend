# Copy to .env and fill in the values.

# Server
NODE_ENV=development
PORT=5050

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Database (Prisma)
# Any remote database MUST include sslmode=require — node-postgres sends the
# password and every query in cleartext without it.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS
#
# Leave all three blank: console mode. The OTP prints to the server log and the
# full login flow works without any provider account. This is the mode to stay
# in until DLT registration completes.
#
# Fill all three: live SMS via MSG91. No code change is needed — the provider is
# chosen from these values at startup, and the server logs which mode it is in.
#
# Partially filled is rejected at boot, since two of three never works.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
