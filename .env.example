# Copy to .env and fill in the values.

# Server
NODE_ENV=development
PORT=5050

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/pandeyneer?schema=public"

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
